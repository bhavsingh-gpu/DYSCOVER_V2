# Security Safety Net
# Ignore all JSON files by default to prevent leaking service keys
*.json
# Whitelist necessary project JSON files
!package.json
!package-lock.json
!tsconfig.json
!jsconfig.json
!manifest.json
!.vscode/extensions.json

# Explicitly ignore known sensitive keys
FIREBASE_KEY_DYSCOVER.json
service-account.json
credentials.json

